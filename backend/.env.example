# Copy to .env and fill in to run the backend with the prod profile locally (e.g. `docker run --env-file .env ...`).
# Never commit the real .env file.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://localhost:5432/repairshop
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (back this up!)
DEVICE_SECRET_KEY=
# Optional: email delivery of password-reset codes. Leave commented out to log codes instead.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=you@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password
# PASSWORD_RESET_MAIL_FROM=you@gmail.com
